POSTGRES_DB=qddxp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgBackRest 每日备份调度（UTC）：每周日 full，其余日期 diff；全新仓库会立即执行 full。
PGBR_SCHEDULE_HOUR_UTC=3
PGBR_CHECK_INTERVAL_SECONDS=300

BIND_PORT=8080
BIND_HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8080
WEB_RETURN_URL=http://localhost:8080/orders

SHOP_NAME=荔枝AI小铺
# Host SVG file path. The application validates the actual XML/SVG content at startup.
SHOP_LOGO_FILE=./assets/shop-logo.svg

ADMIN_KEY=change-me
ORDER_PASSWORD_PEPPER=change-this-in-production
# 允许提供 X-Forwarded-For 的反向代理 CIDR，多个值用逗号分隔。应用直连公网时留空；
# 单个代理优先填写精确的 /32 或 /128 地址，不要信任不受控制的客户端网段。
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
WXPAY_EXPIRE_MINUTES=15
RUST_LOG=info

# 可选：两项必须同时填写，启用可靠的 Telegram 下单/付款通知。
# 私聊必须先向 Bot 发送 /start，再从 getUpdates 读取数字 chat id；@username 仅适用于频道。
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Optional: set all three values to enable 易支付.
EPAY_GATEWAY=
EPAY_PID=
EPAY_KEY=

# Optional: configure all credential values together to enable official WeChat Pay API v3 Native
# payments. The two *_FILE values are exact host file paths mounted read-only by Compose.
# Keep the placeholder files below when WeChat Pay is disabled; replace both with real PEM files
# before filling any WXPAY credential value.
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_MERCHANT_SERIAL_NO=
WXPAY_MERCHANT_PRIVATE_KEY_FILE=./secrets/disabled-placeholder
WXPAY_API_V3_KEY=
WXPAY_PUBLIC_KEY_ID=
WXPAY_PUBLIC_KEY_FILE=./secrets/disabled-placeholder
