POSTGRES_DB=qddxp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

BIND_PORT=8080
BIND_HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8080
WEB_RETURN_URL=http://localhost:8080/delivery

ADMIN_KEY=change-me
ORDER_PASSWORD_PEPPER=change-this-in-production
PAYMENT_EXPIRE_MINUTES=15
RUST_LOG=info

# Optional: set all three values to enable 易支付.
EPAY_GATEWAY=
EPAY_PID=
EPAY_KEY=

# Optional: configure all values together to enable official WeChat Pay API v3 Native payments.
# Put the PEM files under deploy/secrets; this directory is mounted read-only into the container.
# Example paths: /run/secrets/qddxp/apiclient_key.pem and
# /run/secrets/qddxp/wechatpay_public_key.pem.
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_MERCHANT_SERIAL_NO=
WXPAY_MERCHANT_PRIVATE_KEY_PATH=
WXPAY_API_V3_KEY=
WXPAY_PUBLIC_KEY_ID=
WXPAY_PUBLIC_KEY_PATH=
